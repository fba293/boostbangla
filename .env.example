# BoostBangla production environment variables
APP_ENV=production
APP_URL=https://boostbangla.com

# Provider API keys - set these in cPanel/server environment, never commit real values
AMARBOOST_API_KEY=
SMMSUN_API_KEY=
QUICKPANELY_API_KEY=

# Admin secret for manual sync/admin-only endpoints
ADMIN_SYNC_SECRET=
JWT_SECRET=

# CORS allowlist, comma-separated
CORS_ALLOWED_ORIGINS=https://boostbangla.com,https://www.boostbangla.com

# Payment gateways
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=
